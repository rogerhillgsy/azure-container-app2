# Local Functions configuration is loaded from services/integration-worker/local.settings.json.
# These are names/placeholders only; never place real credentials in this file.
AZURE_FUNCTIONS_ENVIRONMENT=Development
ConnectionStrings__Storage=UseDevelopmentStorage=true
PhoneCallsSchedule=REPLACE_WITH_APPROVED_DAILY_CRON_EXPRESSION

# Required before external integration is enabled:
Dataverse__PhoneCallsRequestUri=REPLACE_WITH_APPROVED_DATAVERSE_REQUEST_URI
# Add the approved Dataverse and Webex federated authentication provider settings
# after issuer, audience/scope, and runtime trust configuration are confirmed.
APPLICATIONINSIGHTS_CONNECTION_STRING=
